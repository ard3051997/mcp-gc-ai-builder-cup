# =============================================================================
# App Management System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values

# --- Target App ---
APP_PACKAGE_NAME=com.example.myapp

# --- Google Cloud (Play Store, Analytics, AdMob) ---
# Service account JSON with Play Developer API, Analytics Data API, AdMob API access
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- RevenueCat ---
# API v2 secret key (from RevenueCat Dashboard > API Keys)
REVENUECAT_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx
# Project ID (from RevenueCat Dashboard > Project Settings)
REVENUECAT_PROJECT_ID=proj_xxxxxxxxxxxx

# --- Google Analytics 4 ---
# GA4 Property ID (numeric, from GA4 Admin > Property Settings)
GA4_PROPERTY_ID=123456789

# --- Google AdMob ---
# AdMob Publisher ID (from AdMob Dashboard > Account)
ADMOB_ACCOUNT_ID=pub-1234567890123456

# --- Google Antigravity SDK ---
# Gemini API Key (from https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Logging ---
PLAY_STORE_MCP_LOG_LEVEL=INFO
REVENUECAT_MCP_LOG_LEVEL=INFO
ANALYTICS_MCP_LOG_LEVEL=INFO
ADMOB_MCP_LOG_LEVEL=INFO
ASO_MCP_LOG_LEVEL=INFO

# --- Google Cloud Storage ---
# GCS bucket containing Play Console reports
GCS_PLAY_CONSOLE_BUCKET=pubsite_prod_1234567890123456789

# --- Google Ads (optional) ---
# Path to google-ads.yaml config file (from Google Ads API credentials)
GOOGLE_ADS_CONFIGURATION_FILE_PATH=/path/to/google-ads.yaml
